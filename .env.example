# =============================================================================
#  Jegyzo – környezeti változók (minta)
#  Használat:  copy .env.example .env      (Windows)  /  cp .env.example .env
#  A .env fájl SOHA nem kerül verziókezelésbe (lásd .gitignore).
# =============================================================================

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=jegyzo

# --- Publikált portok (host oldal) ---
# Ha bármelyik foglalt, csak itt írd át – a konténerek belső portjait nem kell.
WEB_PORT=5173          # Jegyzo webes felület
API_PORT=4000          # Jegyzo REST API
POSTGRES_PORT=5432     # Alkalmazás adatbázis (fejlesztői hozzáféréshez)
MAILHOG_UI_PORT=8025   # MailHog webes felület (elküldött e-mailek)
MAILHOG_SMTP_PORT=1025 # MailHog SMTP
KIWI_PORT=8080         # Kiwi TCMS (tesztmenedzsment) – HTTP
KIWI_HTTPS_PORT=8443   # Kiwi TCMS – HTTPS

# --- Alkalmazás adatbázis (PostgreSQL) ---
POSTGRES_DB=jegyzo
POSTGRES_USER=jegyzo
POSTGRES_PASSWORD=jegyzo_dev_pw

# --- API konfiguráció ---
NODE_ENV=development
API_PORT_INTERNAL=4000
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_ACCESS_TTL_SECONDS=900        # hozzáférési token élettartama (15 perc)
JWT_REFRESH_TTL_SECONDS=604800    # refresh token élettartama (7 nap)
BCRYPT_ROUNDS=10
BOOKING_HOLD_MINUTES=10           # jegyzár (foglalás) lejárata
SERVICE_FEE_PER_TICKET=250        # szolgáltatási díj jegyenként (HUF)
DEFAULT_MAX_TICKETS_PER_USER=8    # vásárlói limit eseményenként
DEFAULT_LOCALE=hu
SUPPORTED_LOCALES=hu,en

# --- E-mail (MailHog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM_NAME=Jegyzo
MAIL_FROM_ADDRESS=noreply@jegyzo.local

# --- Webes felület ---
VITE_API_BASE_URL=http://localhost:4000/api

# --- It's a Plan tracker (a JGY backlog forrása) ---
# A tracker stack ugyanezzel a compose fájllal indul (tracker-* szolgáltatások).
# Az értékek SANDBOX alapértékek: éles használatra cseréld le őket.
# Kulcs generálása:  openssl rand -base64 32
TRACKER_VERSION=1.1.0              # rögzített tracker kiadás; a seed ehhez illeszkedik
TRACKER_API_PORT=3000              # tracker REST API / MCP: http://localhost:3000
TRACKER_WEB_PORT=3001              # tracker webes felület
TRACKER_POSTGRES_USER=itsaplan
TRACKER_POSTGRES_PASSWORD=itsaplan_dev_pw   # URL-safe (ne legyen benne + / =)
TRACKER_POSTGRES_DB=itsaplan
TRACKER_BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
TRACKER_APP_ENCRYPTION_KEY=dev-only-app-encryption-key-change-me
TRACKER_S3_ACCESS_KEY_ID=jegyzo-sandbox
TRACKER_S3_SECRET_ACCESS_KEY=dev-only-s3-secret-change-me
TRACKER_S3_BUCKET=planner-attachments
TRACKER_S3_REGION=us-east-1
TRACKER_BACKUP_RETENTION_DAYS=30
TRACKER_TELEMETRY_DISABLED=1
#TRACKER_PRIVACY_URL=
#TRACKER_TERMS_URL=

# --- It's a Plan tracker: API kulcs a toolinghoz ---
# A tools/itsaplan/* eszközök és az .omp/mcp.json MCP szerver innen olvassa.
# Értéke a tracker/README.md-ben dokumentált sandbox kulcs (a seed példányához).
ITSAPLAN_API_KEY=itp_jegyzoSandboxKey000000000000000000000000000000000000000000000000
# Opcionális, alapból http://127.0.0.1:3000
#ITSAPLAN_API_URL=http://127.0.0.1:3000

# --- Kiwi TCMS ---
KIWI_DB_NAME=kiwi
KIWI_DB_USER=kiwi
KIWI_DB_PASSWORD=kiwi_dev_pw
KIWI_DB_ROOT_PASSWORD=kiwi_root_pw
# Az első indításkor létrehozott adminisztrátor (a kiwi-init szolgáltatás használja)
KIWI_ADMIN_USER=admin
KIWI_ADMIN_EMAIL=admin@jegyzo.local
KIWI_ADMIN_PASSWORD=kiwiadmin123
