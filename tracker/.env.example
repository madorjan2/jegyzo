# ─────────────────────────────────────────────────────────────────────────────
#  It's a Plan (tracker) — environment template
#  copy to .env and fill in the REQUIRED values:
#     cp .env.example .env
#
#  Generate a secret with:  openssl rand -base64 32
#  (on Windows PowerShell:  [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})))
# ─────────────────────────────────────────────────────────────────────────────

# --- Project / images ---
COMPOSE_PROJECT_NAME=jegyzo-tracker
VERSION=latest              # pin a tracker release, e.g. VERSION=1.1.0

# --- Published ports (host side) ---
API_PORT=3000               # tracker REST API  -> http://localhost:3000
WEB_PORT=3001               # tracker web UI    -> http://localhost:3001

# --- Database ---
POSTGRES_USER=itsaplan
POSTGRES_PASSWORD=          # REQUIRED — URL-safe (no + / =), e.g. openssl rand -hex 24
POSTGRES_DB=itsaplan

# --- Auth / encryption ---
BETTER_AUTH_SECRET=         # REQUIRED — openssl rand -base64 32
APP_ENCRYPTION_KEY=         # REQUIRED — openssl rand -base64 32 (do not change later)

# --- Object storage (attachments) ---
S3_ACCESS_KEY_ID=           # REQUIRED — any name, 3+ chars
S3_SECRET_ACCESS_KEY=       # REQUIRED — openssl rand -base64 32
S3_BUCKET=planner-attachments
S3_REGION=us-east-1

# --- Public origins (what the browser uses) ---
API_URL=http://localhost:3000
APP_URL=http://localhost:3001

# --- Optional ---
COOKIE_DOMAIN=
PRIVACY_URL=
TERMS_URL=
TELEMETRY_DISABLED=1
BACKUP_RETENTION_DAYS=30
